{
  "htmlWhitespaceSensitivity": "ignore",
  "bracketSpacing": false,
  "overrides": [
    {
      "files": "*.js",
      "options": {
        "singleQuote": true
      }
    },
    {
      "files": "*.ts",
      "options": {
        "singleQuote": true
      }
    },
    {
      "files": "documentation/**/*.md",
      "options": {
        "proseWrap": "never"
      }
    }
  ]
}
