# The asan/ubsan ignorelists are passed to clang via `-fsanitize-blacklist=` as
# a plain `--copt` (see .bazelrc), so they must be declared as compile-action
# inputs or they are absent from the sandbox and clang fails with "no such file
# or directory". The filegroup selects the relevant list per `--config`.
llvm.extra_compiler_files(
    name = "llvm_toolchain",
    label = "//tools/cpp:flags_compiler_inputs",
)
use_repo(
    llvm,
    "llvm_toolchain",
    llvm_aarch64 = "llvm_aarch64_llvm",
    llvm_darwin_aarch64 = "llvm_darwin_aarch64_llvm",
    llvm_k8 = "llvm_k8_llvm",
)

