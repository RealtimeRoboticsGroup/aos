namespace frc.vision;

attribute "static_length";

table TurboJpegDecoderStatus {
  // The number of successful decodings since the last status message.
  successful_decodes:uint (id: 0);
  // The number of unsuccessful decodings since the last status message.
  failed_decodes:uint (id: 1);
  // The most recent decode error message. If no decodings have failed since
  // the last status message, will not be populated.
  // May be truncated.
  last_error_message:string (id: 2, static_length: 128);
  // No longer set.  nvjpeg_decoder used to skip the all-zero warmup frame
  // its old pipelined hardware readback produced; the current one has none.
  skipped_zero_frames:uint (id: 3);
  // Number of already-stale input frames skipped without decoding -- mostly
  // the backlog a watcher drains when the decoder (re)starts against a live
  // camera (nvjpeg_decoder only).
  skipped_stale_frames:uint (id: 4);
  // Number of successfully decoded frames dropped because AOS rejected the
  // send as too fast for the output channel's configured frequency
  // (nvjpeg_decoder only).
  dropped_sends:uint (id: 5);
  // Worst-case age of a published image at publish time (now minus the
  // image's capture timestamp) in this status window, in milliseconds.
  // If this approaches the detector's --max_image_age_ms, detections are
  // about to go dark (nvjpeg_decoder only).
  max_publish_age_ms:uint (id: 6);
}

root_type TurboJpegDecoderStatus;
