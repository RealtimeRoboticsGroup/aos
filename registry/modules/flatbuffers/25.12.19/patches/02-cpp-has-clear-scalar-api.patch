Description: Add clear_field() and has_field() APIs for scalar fields.
    This enables developer parity with protobuf-style interfaces by
    permitting direct checks for field presence and explicit field
    erasure on generated C++ types.
    Implemented by exposing GetMutableVTable() and
    Table::ClearField(voffset_t field) in include/flatbuffers/table.h,
    which zeroes out the corresponding vtable entry, and modifying
    src/idl_gen_cpp.cpp to emit inline clear_{{FIELD_NAME}}() and
    has_{{FIELD_NAME}}() helper methods in the generated code.

    WARNING: ClearField() modifies the vtable in-place. Because
    Flatbuffers deduplicates vtables within the same buffer, modifying
    a vtable for one table instance will affect all other instances
    sharing that same vtable. Use with extreme caution.


diff --git a/include/flatbuffers/table.h b/include/flatbuffers/table.h
index 622d134..e0e8d36 100644
--- a/include/flatbuffers/table.h
+++ b/include/flatbuffers/table.h
@@ -30,6 +30,9 @@ class Table {
   const uint8_t* GetVTable() const {
     return data_ - ReadScalar<soffset_t>(data_);
   }
+  uint8_t* GetMutableVTable() {
+    return data_ - ReadScalar<soffset_t>(data_);
+  }
 
   // This gets the field offset for any of the functions below it, or 0
   // if the field was not present.
@@ -127,6 +130,23 @@ class Table {
     return true;
   }
 
+  // TODO(RealtimeRoboticsGroup/aos#33): Fix or remove.
+  void ClearField(voffset_t field) {
+    // WARNING: This clears the field by modifying the vtable in-place.
+    // If multiple objects share a deduplicated vtable (which FlatBuffers does
+    // by default to save space), clearing the field on one instance will
+    // clear it for all instances sharing that vtable. Use with caution.
+    // The vtable offset is always at the start.
+    auto vtable = GetMutableVTable();
+    // The first element is the size of the vtable (fields + type id + itself).
+    auto vtsize = ReadScalar<voffset_t>(vtable);
+    // If the field we're accessing is outside the vtable, we're reading older
+    // data, so it's the same as if the offset was 0 (not present).
+    if (field < vtsize) {
+      WriteScalar<voffset_t>(reinterpret_cast<uint8_t*>(vtable + field), 0);
+    }
+  }
+
   bool SetPointer(voffset_t field, const uint8_t* val) {
     auto field_offset = GetOptionalFieldOffset(field);
     if (!field_offset) return false;
