load("@@//aos/flatbuffers:build_defs.bzl", "flatbuffer_cc_library")

# Binary Identity Case 4: External, generated fbs compiled directly to .bfbs with full reflection flags
genrule(
    name = "generate_reflection_test_fbs",
    srcs = ["@mock_external_fbs_repo//:reflection_test.fbs"],
    outs = ["reflection_test.fbs"],
    cmd = "cp $< $@",
)

flatbuffer_cc_library(
    name = "reflection_test_fbs",
    srcs = [":reflection_test.fbs"],
    gen_reflections = True,
    visibility = ["//visibility:public"],
)
