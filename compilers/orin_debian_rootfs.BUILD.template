load("@rules_cc//cc:defs.bzl", "cc_library")

# Pieces of the CUDA 12.6 toolkit shipped inside the Yocto sysroot. Exposed
# so //tools/cuda can wire them into a rules_cuda toolchain.
exports_files(
    [
        "usr/local/cuda-12.6/bin/aarch64-unknown-linux-gnu-fatbinary",
        "usr/local/cuda-12.6/bin/bin2c",
        "usr/local/cuda-12.6/bin/nvlink",
        "usr/local/cuda-12.6/bin/ptxas",
        "usr/local/cuda-12.6/nvvm/libdevice/libdevice.10.bc",
    ],
    visibility = ["//visibility:public"],
)

# Everything under the CUDA 12.6 toolkit root, so //tools/cuda can build
# a synthetic CUDA root that mirrors include/, nvvm/, and lib/ while
# replacing the x86_64 host tools in bin/ with wrappers.
filegroup(
    name = "cuda_12_6_root",
    srcs = glob(["usr/local/cuda-12.6/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sysroot_files",
    srcs = glob(
        include = [
            "include/**",
            "lib/**",
            "lib64/**",
            "usr/include/**",
            "usr/local/**",
            "usr/lib/**",
            "usr/lib64/**",
        ],
        exclude = [
            "usr/share/**",
        ],
    ),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "argus",
    srcs = [
        "usr/lib/libnvargus_socketclient.so",
    ],
    hdrs = glob(
        include = ["usr/include/Argus/**"],
    ),
    includes = ["usr/include/Argus/utils/"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "eglstream",
    hdrs = glob(
        include = ["usr/include/EGLStream/**"],
    ),
    includes = ["usr/include/EGLStream/"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "nvbufsurface",
    srcs = [
        "usr/lib/libnvbufsurface.so.1.0.0",
    ],
    visibility = ["//visibility:public"],
)

# NVIDIA's TEGRA_ACCELERATE build of libjpeg-8b, which drives the NVJPG
# engine.  Consumers must compile with -DTEGRA_ACCELERATE to get the
# matching struct layout.
cc_library(
    name = "nvjpeg",
    srcs = [
        "usr/lib/libnvjpeg.so",
    ],
    hdrs = glob(
        include = ["usr/include/libjpeg-8b/*.h"],
    ),
    includes = ["usr/include/libjpeg-8b/"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "cudart",
    srcs = [
        "usr/lib/libcuda.so.1.1",
        "usr/local/cuda-11.8/lib/libcudart.so.11.0",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "tensorrt",
    visibility = ["//visibility:public"],
    deps = [
        ":tensorrt-core-dev-headers",
        ":usr_lib_libnvinfer.so.10.3.0-lib",
    ],
)

{{ RULES }}
