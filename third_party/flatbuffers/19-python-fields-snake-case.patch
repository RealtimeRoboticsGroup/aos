+    const std::string type_field_name = namer_.Field(*field.sibling_union_field);
     code += GenIndents(2) + "self." + field_field + " = " + union_type +
-            "Creator(" + "self." + field_field + "Type, " + struct_var + "." +
+            "Creator(" + "self." + type_field_name + ", " + struct_var + "." +
             field_method + "())";
   }
