+#if SANITIZER_GLIBC
+INTERCEPTOR(void *, __memcpy_chk, void *dest, const void *src, SIZE_T n,
+            SIZE_T dest_size) {
+  if (!msan_inited)
+    return internal_memcpy(dest, src, n);
+  if (msan_init_is_running || __msan::IsInSymbolizerOrUnwider())
