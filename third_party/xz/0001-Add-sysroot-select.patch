+# Platform-specific lzma library:
+# - macOS, Android, Windows, iOS: built from source
+# - Linux: uses Debian sysroot (except under MSan, where we build from source)
+alias(
+    name = "lzma",
+    actual = select({
+        ":linux_arm64_msan": ":lzma_src",
+        ":linux_x86_64_msan": ":lzma_src",
