From 84890ca37e51bb4bed4092f466fe826a44069c8b Mon Sep 17 00:00:00 2001
From: Austin Schuh <austin.linux@gmail.com>
Date: Tue, 28 Apr 2026 14:02:23 -0700
Subject: [PATCH] Pass -std= through to clang CUDA compile actions

When the cc_toolchain compiles host C++ with a configured -std= flag, we
want clang's CUDA frontend to use the same standard for the device-side
TU. Otherwise libstdc++ headers that are valid in C++20/23 mode fail to
parse. nvcc handles -std= itself so keep stripping it for nvcc.
---
 cuda/private/cuda_helper.bzl | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/cuda/private/cuda_helper.bzl b/cuda/private/cuda_helper.bzl
index d01c3db..c4e340d 100644
--- a/cuda/private/cuda_helper.bzl
+++ b/cuda/private/cuda_helper.bzl
@@ -296,10 +296,13 @@ def _get_cc_host_compile_flags(ctx):
     extra = ["-fno-canonical-system-headers"] if cuda_toolchain.toolchain_identifier == "clang" else []
     flags_to_skip = list(base) + extra
 
-    flag_prefixes_to_skip = [
-        "-std=",
-        "--sysroot=",
-    ]
+    # For clang (the cuda compiler is the same clang as the host compiler),
+    # keep `-std=` so the C++ standard configured by the cc_toolchain (e.g.
+    # `-std=c++20`) reaches the cuda_compile action. nvcc has its own `-std=`
+    # handling, so strip it there to avoid double-passing.
+    flag_prefixes_to_skip = ["--sysroot="]
+    if cuda_toolchain.toolchain_identifier != "clang":
+        flag_prefixes_to_skip.append("-std=")
 
     flags_with_value_to_skip = [
         "--sysroot",
-- 
