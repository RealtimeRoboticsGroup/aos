From bf77122c07611b0a6c9337b21625797eede40d7c Mon Sep 17 00:00:00 2001
From: Austin Schuh <austin.linux@gmail.com>
Date: Tue, 28 Apr 2026 14:02:23 -0700
Subject: [PATCH] Inject BAZEL_CURRENT_REPOSITORY into cuda_library

Bazel's native cc_library passes BAZEL_CURRENT_REPOSITORY as a private
define so runfiles helpers (e.g. @bazel_tools//tools/cpp/runfiles) can
resolve the owning repo at compile time. cuda_library skipped this,
which broke any cuda TU that pulls in those headers transitively.
---
 cuda/private/cuda_helper.bzl | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/cuda/private/cuda_helper.bzl b/cuda/private/cuda_helper.bzl
index c4e340d..4a1e015 100644
--- a/cuda/private/cuda_helper.bzl
+++ b/cuda/private/cuda_helper.bzl
@@ -367,8 +367,15 @@ def _create_common(ctx):
     transitive_linking_contexts = [merged_cc_info.linking_context]
 
     # gather compile info
+    # Bazel's native cc_library injects BAZEL_CURRENT_REPOSITORY as a
+    # private define so `@bazel_tools//tools/cpp/runfiles` (and rules_cc's
+    # equivalent) can find the right runfiles tree. Mirror that for
+    # cuda_library so consumers depending on runfiles compile cleanly.
+    bazel_current_repo = '"%s"' % (ctx.label.repo_name or "")
     defines = []
-    local_defines = [i for i in attr.local_defines]
+    local_defines = [i for i in attr.local_defines] + [
+        "BAZEL_CURRENT_REPOSITORY=" + bazel_current_repo,
+    ]
     compile_flags = attr._default_cuda_copts[BuildSettingInfo].value + [o for o in attr.copts if _check_opts(o)]
     link_flags = []
     if hasattr(attr, "linkopts"):
