commit 0000000000000000000000000000000000000000
Author: AOS <aos@example.com>
Date:   Fri Jun 6 2026 -0700

    Suppress MemorySanitizer on intentional swisstable uninitialized reads

    The swisstable accessors (MaybeInitializedPtr::get, HeapOrSoo::control,
    HeapOrSoo::slot_array, HeapOrSoo::get_soo_data) intentionally read members
    that may be uninitialized for empty or SOO tables. The existing
    ABSL_SWISSTABLE_IGNORE_UNINITIALIZED suppression only silenced GCC's
    -Wmaybe-uninitialized, which is a compile-time diagnostic. Under
    Clang + MemorySanitizer these deliberate reads are reported at runtime
    (e.g. when growing an empty flat_hash_map during static flag registration
    via FlagRegistry::RegisterFlag). Mark the bytes as initialized under MSan,
    mirroring the GCC suppression. SanitizerUnpoisonMemoryRegion is a no-op
    unless a sanitizer is enabled, so non-sanitizer builds are unaffected.

diff --git a/absl/container/internal/raw_hash_set.h b/absl/container/internal/raw_hash_set.h
index 1111111..2222222 100644
--- a/absl/container/internal/raw_hash_set.h
+++ b/absl/container/internal/raw_hash_set.h
@@ -858,6 +858,21 @@
   _Pragma("GCC diagnostic pop")
 #define ABSL_SWISSTABLE_IGNORE_UNINITIALIZED_RETURN(x) \
   ABSL_SWISSTABLE_IGNORE_UNINITIALIZED(return x)
+#elif defined(ABSL_HAVE_MEMORY_SANITIZER)
+// Unlike GCC's -Wmaybe-uninitialized (a compile-time diagnostic),
+// MemorySanitizer is a runtime tool and reports these intentional reads of
+// possibly-uninitialized values (e.g. slot_array for empty tables). Mark the
+// storage initialized so MSan does not flag them, preserving value/reference
+// category for the various accessors. SanitizerUnpoisonMemoryRegion is a no-op
+// unless a sanitizer is enabled.
+template <typename T>
+inline T&& SwisstableIgnoreUninitialized(T&& value) {
+  SanitizerUnpoisonMemoryRegion(&value, sizeof(value));
+  return static_cast<T&&>(value);
+}
+#define ABSL_SWISSTABLE_IGNORE_UNINITIALIZED(x) x
+#define ABSL_SWISSTABLE_IGNORE_UNINITIALIZED_RETURN(x) \
+  return SwisstableIgnoreUninitialized(x)
 #else
 #define ABSL_SWISSTABLE_IGNORE_UNINITIALIZED(x) x
 #define ABSL_SWISSTABLE_IGNORE_UNINITIALIZED_RETURN(x) return x
