[{BUILD,*.bzl,*.bazel}]
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100
tab_width = 4

[*.{cc,h}]
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80
tab_width = 2
